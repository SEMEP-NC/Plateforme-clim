#Version
APP_VERSION=2.0 (10/2026)

# Base de données , mots de passes a modifier avant build
MYSQL_ROOT_PASSWORD=rootpassword
DB_HOST=db
DB_NAME=clim_manager
DB_USER=climuser
DB_PASSWORD=climpassword

# Ports
WEB_PORT=8085
MODBUS_PORT=8500

# Scheduler
SCHEDULER_INTERVAL=120
DISCOVERY_INTERVAL=3600
HISTORY_RETENTION_DAYS=90

# Modbus Hub
HUB_URL=http://modbus-hub:8500/read
HUB_WRITE_URL=http://modbus-hub:8500/write

# Fuseau horaire
TZ=Pacific/Noumea

# Node-RED (intégration modbus-hub)
NODERED_PORT=1880
NODERED_USER=admin
# Générer avec : docker compose run --rm node-red node-red admin hash-pw
NODERED_PASSWORD_HASH=

#Certification
HOST_NAME=clim.semep.nc  #si pas de DNS mettre adresse IP 
HOST_IP=10.0.0.39
CA_PASSWORD=MotDePasseAChanger
